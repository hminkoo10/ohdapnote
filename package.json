{
  "name": "ohdapnote",
  "productName": "OhdapNote",
  "version": "0.4.12",
  "description": "문제집과 답지 PDF를 스캔해 틀린 문제만 모아 PDF로 만들어 주는 수학 오답노트 프로그램",
  "main": "src/main/main.js",
  "author": {
    "name": "구현민",
    "url": "https://github.com/hminkoo10"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hminkoo10/ohdapnote.git"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:fixtures": "node test/fixtures/make-fixtures.mjs && node test/fixtures/make-books.mjs && node test/fixtures/make-passages.mjs",
    "test:detect": "node test/e2e/detect-fixtures.mjs",
    "test:books": "node test/e2e/books-test.mjs",
    "test:passages": "node test/e2e/passage-test.mjs",
    "test:scan": "node test/e2e/scan-check.mjs",
    "test:e2e": "node test/e2e/app-e2e.mjs && node test/e2e/app-check.mjs && node test/e2e/app-background.mjs",
    "dist": "node scripts/fetch-model.mjs && electron-builder --win dir --x64 --publish never && node scripts/write-manifest.mjs",
    "release:patch": "npm version patch -m \"v%s 배포\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"v%s 배포\" && git push --follow-tags",
    "release:major": "npm version major -m \"v%s 배포\" && git push --follow-tags"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "electron-log": "5.4.4",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "lucide-static": "^1.56.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pretendard": "^1.3.9",
    "tesseract.js": "7.0.0"
  },
  "build": {
    "appId": "io.github.hminkoo10.ohdapnote",
    "productName": "OhdapNote",
    "copyright": "Copyright © 2026 구현민",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!src/**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/{DirectML,dxcompiler}.dll"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "extraResources": [
      {
        "from": "build/models",
        "to": "models",
        "filter": [
          "**/*",
          "!**/*.part"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "OhdapNote"
    }
  }
}
