{
  "name": "ohdapnote",
  "productName": "OhdapNote",
  "version": "0.2.2",
  "description": "문제집과 답지 PDF를 스캔해 틀린 문제만 모아 PDF로 만들어 주는 수학 오답노트 프로그램",
  "main": "src/main/main.js",
  "author": {
    "name": "구현민",
    "url": "https://github.com/hminkoo10"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hminkoo10/ohdapnote.git"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:fixtures": "node test/fixtures/make-fixtures.mjs && node test/fixtures/make-books.mjs",
    "test:detect": "node test/e2e/detect-fixtures.mjs",
    "test:books": "node test/e2e/books-test.mjs",
    "test:scan": "node test/e2e/scan-check.mjs",
    "test:e2e": "node test/e2e/app-e2e.mjs && node test/e2e/app-check.mjs",
    "dist": "electron-builder --win --x64 --publish never",
    "release:patch": "npm version patch -m \"v%s 배포\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"v%s 배포\" && git push --follow-tags",
    "release:major": "npm version major -m \"v%s 배포\" && git push --follow-tags"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "lucide-static": "^1.56.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pretendard": "^1.3.9",
    "tesseract.js": "7.0.0"
  },
  "build": {
    "appId": "io.github.hminkoo10.ohdapnote",
    "productName": "OhdapNote",
    "copyright": "Copyright © 2026 구현민",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!src/**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "OhdapNote"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "오답노트",
      "uninstallDisplayName": "오답노트",
      "artifactName": "OhdapNote-Setup-${version}.${ext}",
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hminkoo10",
        "repo": "ohdapnote",
        "releaseType": "release"
      }
    ]
  }
}
